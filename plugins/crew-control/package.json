{
  "name": "crew-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Crew Control: server irisan tipis (harness claude, SSE, Chat)",
  "scripts": {
    "dev": "concurrently -k -n server,web \"node --env-file-if-exists=.env --import tsx --watch src/main.ts\" \"vite web\"",
    "build": "vite build web",
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "seed": "node --import tsx src/seed.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web"
  },
  "dependencies": {
    "@fastify/static": "10.1.10",
    "@tanstack/react-query": "5.106.0",
    "fastify": "^5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "6.4.5"
  }
}
