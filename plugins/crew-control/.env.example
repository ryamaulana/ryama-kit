# Semua opsional. Tanpa nilai rahasia.
CREW_PORT=4780
# Default hanya localhost. Untuk Tailscale isi dengan IP Tailscale laptop (100.x.y.z), bukan 0.0.0.0.
CREW_HOST=127.0.0.1
# Folder kerja (akar tetap): run boleh di akar ini atau folder di bawahnya, kedalaman bebas.
CREW_WORK_ROOT=D:\01_Workspace
CREW_DB=data/crew.db
# Rekomendasi KEPUTUSAN.md: mulai 1 run aktif.
CREW_DEFAULT_MODEL=sonnet
CREW_MAX_RUNS=1
CREW_CLAUDE_BIN=claude
# Tambahan nama host / origin yang dipercaya (pisah koma), mis. proxy dev Vite.
CREW_ALLOWED_HOSTS=
CREW_ALLOWED_ORIGINS=
# Login Tailscale yang boleh membuka lewat https://<laptop>.ts.net (pisah koma), mis. pemilik@example.com. Kosong = semua anggota tailnet.
CREW_TAILSCALE_USERS=
